{
  "ten": {
    "predefined_graphs": [
      {
        "name": "voice_assistant",
        "auto_start": true,
        "graph": {
          "nodes": [
            {
              "type": "extension",
              "name": "websocket_server",
              "addon": "websocket_server",
              "extension_group": "default",
              "property": {
                "port": 8765,
                "host": "0.0.0.0",
                "sample_rate": 16000,
                "channels": 1,
                "bytes_per_sample": 2
              }
            },
            {
              "type": "extension",
              "name": "stt",
              "addon": "bytedance_llm_based_asr",
              "extension_group": "stt",
              "property": {
                "params": {
                  "access_key": "${env:BYTEDANCE_ASR_ACCESS_KEY}",
                  "language": "zh-CN",
                  "app_key": "${env:BYTEDANCE_ASR_APP_KEY}",
                  "resource_id": "${env:BYTEDANCE_ASR_RESOURCE_ID}",
                  "model_version": "${env:BYTEDANCE_ASR_LLM_MODEL_VERSION|}"
                }
              }
            },
            {
              "type": "extension",
              "name": "llm",
              "addon": "openai_llm2_python",
              "extension_group": "chatgpt",
              "property": {
                "base_url": "https://ark.cn-beijing.volces.com/api/v3",
                "api_key": "${env:VOLC_OPENAI_API_KEY}",
                "prompt": "你是某公司负责招聘应届生的面试官，需要与面试者{{studentName}}进行面试对话，招聘的岗位是：{{job}}，同时你也是此岗位方向的专家。面试流程如下：1. 简短介绍此公司的业务和你的身份，以及此岗位的职责的简短说明。2. 让应聘者进行自我介绍，等待应聘者完成自我介绍后进行下一步的提问。3. 根据面试者的自我介绍和下面提供的面试者信息，开始提问。问题重点关注自我介绍与获取到的面试者信息中的冲突点、成就达成、专业技能。4. 根据下述提供的岗位要求和面试者信息中体现的专业技能点，依次提问三到五个专业技能问题。提问和回复的方式：每次提问只提出一个问题，不要一次性提出多个问题。若应聘者回答地不够全面，则根据其回答进行拓展性追问。若应聘者回答地不够准确，则根据其回答进行确认性追问。应聘者单个回答的问题追问最多进行3轮。在对话中可以称呼面试者为{{studentName}}。当你需要提问的问题已经问完，可以主动询问面试者是否还有问题。异常输入处理：当面试者的输入内容持续重复或明显偏离面试主题时，进行温和引导。多次异常后可终止面试。你作为面试官的风格：{{persona_prompt}} 招聘岗位要求：{{jobProfile}} 面试者信息：{{studentInfo}} {{detailInfo}}",
                "model": "ep-20251010142720-svlxj",
                "proxy_url": "${env:OPENAI_PROXY_URL|}"
              }
            },
            {
              "type": "extension",
              "name": "tts",
              "addon": "bytedance_tts_duplex",
              "extension_group": "tts",
              "property": {
                "dump": false,
                "dump_path": "./",
                "params": {
                  "app_id": "${env:BYTEDANCE_TTS_APPID}",
                  "token": "${env:BYTEDANCE_TTS_TOKEN}",
                  "speaker": "zh_female_shuangkuaisisi_moon_bigtts",
                  "audio_params": {
                    "sample_rate": 16000
                  }
                }
              }
            },
            {
              "type": "extension",
              "name": "avatar_musetalk",
              "addon": "avatar_musetalk_python",
              "extension_group": "avatar",
              "property": {
                "service_base_url": "http://172.20.0.1:7800",
                "video_path": "/home/mssj/LiveTalking/data/raw_video/张111.mp4",
                "avatar_id": "muse_libai",
                "output_width": 540,
                "output_height": 960,
                "output_fps": 25,
                "pixel_fmt": "i420",
                "input_audio_sample_rate": 16000,
                "video_frame_name": "video_frame",
                "min_chunk_ms": 40,
                "binary_frames": true,
                "audio_pacing_scale": 1.0
              }
            },
            {
              "type": "extension",
              "name": "main_control",
              "addon": "main_python",
              "extension_group": "control",
              "property": {
                "greeting": "Agent已连接，有什么需要帮助的吗？"
              }
            },
            {
              "type": "extension",
              "name": "message_collector",
              "addon": "message_collector2",
              "extension_group": "transcriber",
              "property": {}
            },
            {
              "type": "extension",
              "name": "weatherapi_tool_python",
              "addon": "weatherapi_tool_python",
              "extension_group": "default",
              "property": {
                "api_key": "${env:WEATHERAPI_API_KEY|}"
              }
            }
          ],
          "connections": [
            {
              "extension": "main_control",
              "cmd": [
                {
                  "names": [
                    "tool_register"
                  ],
                  "source": [
                    {
                      "extension": "weatherapi_tool_python"
                    }
                  ]
                }
              ],
              "data": [
                {
                  "name": "asr_result",
                  "source": [
                    {
                      "extension": "stt"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "websocket_server",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "dest": [
                    {
                      "extension": "stt"
                    }
                  ]
                },
                {
                  "name": "pcm_frame",
                  "source": [
                    {
                      "extension": "tts"
                    }
                  ]
                }
              ],
              "video_frame": [
                {
                  "name": "video_frame",
                  "source": [
                    {
                      "extension": "avatar_musetalk"
                    }
                  ]
                }
              ],
              "data": [
                {
                  "name": "data",
                  "source": [
                    {
                      "extension": "message_collector"
                    }
                  ]
                }
              ]
            },
            {
              "extension": "avatar_musetalk",
              "audio_frame": [
                {
                  "name": "pcm_frame",
                  "source": [
                    {
                      "extension": "tts"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "log": {
      "handlers": [
        {
          "matchers": [
            {
              "level": "info"
            }
          ],
          "formatter": {
            "type": "plain",
            "colored": true
          },
          "emitter": {
            "type": "console",
            "config": {
              "stream": "stdout"
            }
          }
        }
      ]
    }
  }
}
